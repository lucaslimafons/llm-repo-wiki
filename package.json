{
  "name": "llm-repo-wiki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx --env-file=.env.local src/worker.ts",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "setup": "docker compose up -d --wait db && pnpm db:migrate"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.152",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@tanstack/react-query": "5.104.5",
    "ai": "7.0.148",
    "code-chunk": "0.1.14",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "next": "16.4.2",
    "pg-boss": "12.38.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tar": "^7.5.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pg-boss/dashboard": "1.12.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
