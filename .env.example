# Copy to .env.local. Everything here stays on your machine.
DATABASE_URL=postgres://wiki:wiki@127.0.0.1:5433/wiki

# Create a dedicated key with a credit limit: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional. Public repos work without it (60 req/h); a fine-grained read-only
# token (Contents + Metadata) raises that to 5000 req/h and unlocks private repos.
GITHUB_TOKEN=

# Optional. Repos under other owners, one token each: owner=token,other-owner=token
# Falls back to GITHUB_TOKEN for any owner not listed. See README "Private repositories".
GITHUB_TOKENS=

# Optional. Only needed if you forward GitHub webhooks (gh webhook forward).
GITHUB_WEBHOOK_SECRET=

# Chat: interactive, tool-heavy. Author: background page writing, input-heavy.
# Comparison and alternatives: docs/models.md
CHAT_MODEL=anthropic/claude-haiku-5.5
AUTHOR_MODEL=anthropic/claude-haiku-5.5
# Changing the embedding model means re-embedding everything (pnpm reindex).
EMBEDDING_MODEL=openai/text-embedding-3-small
# Only the /explain view's optional "rerank" step calls it (one paid call per click).
# RERANK_MODEL=cohere/rerank-4-pro

# Route every model call to zero-data-retention endpoints that never collect prompts. Keep this
# true for private code: a model without a ZDR endpoint then fails instead of leaking.
OPENROUTER_ZDR=true

# How often the worker checks each repo's default branch for new commits.
POLL_INTERVAL_MINUTES=5
# Tokens (input + output) one author run may spend before it stops. A 746-file repo needed ~414k.
# AUTHOR_TOKEN_BUDGET=800000
