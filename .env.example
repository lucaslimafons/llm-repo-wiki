# Copy to .env.local. Everything here stays on your machine.
DATABASE_URL=postgres://wiki:wiki@127.0.0.1:5433/wiki

# Create a dedicated key with a credit limit: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional. Public repos work without it (60 req/h); a fine-grained read-only
# token (Contents + Metadata) raises that to 5000 req/h and unlocks private repos.
GITHUB_TOKEN=

# Optional. Only needed if you forward GitHub webhooks (gh webhook forward).
GITHUB_WEBHOOK_SECRET=

CHAT_MODEL=anthropic/claude-sonnet-5.5
AUTHOR_MODEL=anthropic/claude-haiku-5.5
# Changing the embedding model means re-embedding everything (pnpm reindex).
EMBEDDING_MODEL=openai/text-embedding-3-small

# How often the worker checks each repo's default branch for new commits.
POLL_INTERVAL_MINUTES=5
